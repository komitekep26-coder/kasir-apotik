<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ApotekPOS — Sistem Kasir Apotek</title>
<style>
:root{--navy:#123047;--teal:#0e9f91;--bg:#f3f6f8;--ink:#183044;--muted:#6c7d89;--line:#e3eaee;--red:#c74646;--amber:#b7791f}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,system-ui,Arial,sans-serif}
button,input,select{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:10px 14px;background:var(--teal);color:white;font-weight:650}button.secondary{background:#e9f0f3;color:var(--ink)}button.danger{background:#b94242}button:disabled{opacity:.45;cursor:not-allowed}
.app{display:grid;grid-template-columns:238px 1fr;min-height:100vh}.side{background:var(--navy);color:#fff;padding:22px 15px;display:flex;flex-direction:column;gap:8px}.brand{font-size:20px;font-weight:800;padding:5px 10px 22px}.brand small{display:block;color:#a8c5d1;font-size:11px;font-weight:500}.nav{background:transparent;text-align:left;color:#d5e3e9;padding:12px;border-radius:9px}.nav.active,.nav:hover{background:#24495d;color:#fff}.sidefoot{margin-top:auto;color:#a8c5d1;font-size:12px;padding:10px}
main{min-width:0}.top{height:66px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 26px;position:sticky;top:0;z-index:2}.top strong{font-size:16px}.content{padding:25px;max-width:1500px;margin:auto}.pagehead{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:20px}.pagehead h1{font-size:24px;margin:0}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:0 2px 8px #16364a08}.metric{font-size:25px;font-weight:800;margin-top:8px}.metriclabel{color:var(--muted);font-size:12px}.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,1fr);gap:16px}.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.field{display:flex;flex-direction:column;gap:5px;margin:8px 0}.field label{font-size:12px;color:var(--muted);font-weight:650}.field input,.field select,.search{border:1px solid #d7e1e6;border-radius:8px;padding:10px;background:#fff;color:var(--ink);min-width:0;width:100%}.search{max-width:360px}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;white-space:nowrap}th,td{text-align:left;padding:11px 10px;border-bottom:1px solid var(--line)}th{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}td{font-size:13px}.pill{display:inline-block;padding:4px 8px;border-radius:30px;background:#e7f6f2;color:#087e70;font-size:11px;font-weight:700}.pill.warn{background:#fff2d8;color:#96610b}.pill.bad{background:#fde8e8;color:#a52c2c}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:15px}.tabs button{background:#e7eef1;color:#3d5664}.tabs button.active{background:var(--navy);color:white}.productgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.product{border:1px solid var(--line);background:#fff;border-radius:10px;padding:12px;text-align:left;color:var(--ink)}.product:hover{border-color:var(--teal)}.product b{display:block;margin:5px 0}.product small{color:var(--muted)}.cartline{display:grid;grid-template-columns:1fr auto;gap:8px;padding:10px 0;border-bottom:1px solid var(--line)}.total{font-size:23px;font-weight:800}.notice{background:#fff7e6;border:1px solid #f4dfb5;border-radius:10px;padding:12px;color:#785315;margin-bottom:14px}.empty{text-align:center;padding:30px;color:var(--muted)}.hidden{display:none!important}.modalback{position:fixed;inset:0;background:#102b3a88;display:grid;place-items:center;padding:15px;z-index:5}.modal{background:#fff;border-radius:14px;padding:22px;width:min(520px,100%);max-height:90vh;overflow:auto}.modal h2{margin-top:0}.toast{position:fixed;right:20px;bottom:20px;background:#17394c;color:#fff;padding:12px 17px;border-radius:10px;z-index:9}.small{font-size:12px}.actions{display:flex;gap:6px}.footerhint{font-size:11px;color:var(--muted);margin-top:15px}
@media(max-width:900px){.app{grid-template-columns:1fr}.side{position:sticky;top:0;z-index:3;padding:8px;flex-direction:row;overflow:auto;align-items:center}.brand{padding:5px 10px;white-space:nowrap}.brand small{display:none}.nav{white-space:nowrap;padding:9px}.sidefoot{display:none}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}.content{padding:15px}.top{padding:0 15px}}
@media(max-width:520px){.grid{grid-template-columns:1fr 1fr;gap:8px}.card{padding:13px}.metric{font-size:20px}.productgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.pagehead{align-items:flex-start;flex-direction:column}.pagehead h1{font-size:21px}}
@media print{.side,.top,.no-print{display:none!important}.app{display:block}.content{padding:0}.card{box-shadow:none}}
</style></head>
<body>
<div class="app">
<aside class="side">
<div class="brand">✚ ApotekPOS<small>SISTEM KASIR & MANAJEMEN APOTEK</small></div>
<button class="nav active" data-page="dashboard">▦ Dashboard</button>
<button class="nav" data-page="kasir">▣ Kasir / Penjualan</button>
<button class="nav" data-page="produk">▤ Data Obat & Produk</button>
<button class="nav" data-page="stok">◫ Stok & Kedaluwarsa</button>
<button class="nav" data-page="pembelian">⇩ Pembelian</button>
<button class="nav" data-page="laporan">▥ Laporan</button>
<button class="nav" data-page="pengguna">♙ Pengguna</button>
<div class="sidefoot">Versi prototipe 1.0<br>Data tersimpan di browser ini</div>
</aside>
<main><header class="top"><strong id="topTitle">Dashboard</strong><div class="row"><span class="muted small" id="who">Pemilik</span><button class="secondary small" onclick="resetDemo()">Reset data demo</button></div></header>
<div class="content">
<section id="dashboard" class="page">
<div class="pagehead"><div><h1>Dashboard apotek</h1><div class="muted">Ringkasan operasional hari ini</div></div><span class="pill">● Sistem aktif (lokal)</span></div>
<div class="grid" id="metrics"></div>
<div class="grid" style="grid-template-columns:1.4fr 1fr;margin-top:15px">
<div class="card"><h3>Penjualan 7 hari terakhir</h3><div id="salesChart" class="muted"></div></div>
<div class="card"><h3>Perhatian stok</h3><div id="alerts"></div></div></div>
<div class="card" style="margin-top:15px"><h3>Transaksi terbaru</h3><div id="recent"></div></div>
</section>
<section id="kasir" class="page hidden">
<div class="pagehead"><div><h1>Kasir / Penjualan</h1><div class="muted">Pilih produk, masukkan jumlah, lalu proses pembayaran</div></div></div>
<div class="notice">Obat bertanda <b>Resep</b> memerlukan verifikasi resep oleh apoteker/tenaga berwenang sebelum penyerahan. Prototipe ini tidak menggantikan kewajiban pelayanan kefarmasian dan ketentuan obat khusus.</div>
<div class="layout"><div class="card"><div class="row" style="justify-content:space-between"><h3>Daftar produk</h3><input class="search" id="productSearch" placeholder="Cari nama / kode / barcode..." oninput="renderProducts()"></div><div class="productgrid" id="productGrid"></div></div>
<div class="card"><h3>Keranjang</h3><div id="cart"></div><div class="field"><label>Diskon transaksi (Rp)</label><input id="discount" type="number" min="0" value="0" oninput="renderCart()"></div><div class="field"><label>Metode pembayaran</label><select id="payMethod"><option>Tunai</option><option>QRIS</option><option>Transfer bank</option><option>Debit</option></select></div><div class="field"><label>Uang diterima (Rp, untuk tunai)</label><input id="paid" type="number" min="0" placeholder="Masukkan nominal"></div><div class="row" style="justify-content:space-between"><span class="muted">Total bayar</span><span class="total" id="cartTotal">Rp0</span></div><div class="row" style="justify-content:space-between;margin:10px 0"><span class="muted">Kembalian</span><b id="change">Rp0</b></div><button style="width:100%" onclick="checkout()">Proses transaksi</button><div class="footerhint">Transaksi demo dicatat di perangkat ini. Pastikan stok dan resep telah diverifikasi.</div></div></div>
</section>
<section id="produk" class="page hidden">
<div class="pagehead"><div><h1>Data obat & produk</h1><div class="muted">Kelola identitas, harga, stok minimum, dan status resep</div></div><button onclick="openProduct()">+ Tambah produk</button></div>
<div class="card"><div class="row" style="justify-content:space-between;margin-bottom:12px"><input class="search" id="invSearch" placeholder="Cari produk..." oninput="renderInventory()"><span class="muted small" id="productCount"></span></div><div class="tablewrap" id="inventoryTable"></div></div>
</section>
<section id="stok" class="page hidden">
<div class="pagehead"><div><h1>Stok & kedaluwarsa</h1><div class="muted">Pantau jumlah stok, batch, dan tanggal kedaluwarsa</div></div><button onclick="openBatch()">+ Catat stok masuk / batch</button></div>
<div class="notice">Gunakan prinsip FEFO (First Expired, First Out). Pisahkan dan jangan menjual produk kedaluwarsa atau rusak. Data batch pada prototipe perlu diverifikasi dengan stok fisik.</div>
<div class="card"><div class="tablewrap" id="stockTable"></div></div>
</section>
<section id="pembelian" class="page hidden">
<div class="pagehead"><div><h1>Pembelian & pemasok</h1><div class="muted">Pencatatan penerimaan barang dari pemasok</div></div><button onclick="openPurchase()">+ Catat pembelian</button></div>
<div class="card"><div class="tablewrap" id="purchaseTable"></div></div>
</section>
<section id="laporan" class="page hidden">
<div class="pagehead"><div><h1>Laporan</h1><div class="muted">Rekap transaksi berdasarkan tanggal</div></div><button class="secondary" onclick="window.print()">Cetak / Simpan PDF</button></div>
<div class="card"><div class="row"><div class="field"><label>Dari tanggal</label><input id="fromDate" type="date"></div><div class="field"><label>Sampai tanggal</label><input id="toDate" type="date"></div><button onclick="renderReports()">Tampilkan</button></div><div id="reportSummary"></div><div class="tablewrap" id="reportTable"></div></div>
</section>
<section id="pengguna" class="page hidden">
<div class="pagehead"><div><h1>Pengguna & hak akses</h1><div class="muted">Contoh pembagian akses operasional</div></div><button onclick="openUser()">+ Tambah pengguna</button></div>
<div class="card"><div class="notice">Login dan otorisasi pada file demo ini hanya simulasi antarmuka. Jangan gunakan untuk menyimpan kata sandi atau data pasien sungguhan.</div><div class="tablewrap" id="userTable"></div></div>
</section>
</div></main></div>
<div id="modalRoot"></div><div id="toast" class="toast hidden"></div>
<script>
const money=n=>'Rp'+Math.round(Number(n)||0).toLocaleString('id-ID');
const today=()=>new Date().toISOString().slice(0,10);
const plus=(d,n)=>{let x=new Date(d);x.setDate(x.getDate()+n);return x.toISOString().slice(0,10)};
const seedProducts=[
{id:1,code:'OBT001',barcode:'899100100001',name:'Paracetamol 500 mg',category:'Obat bebas',unit:'Strip',buy:3500,price:5000,stock:45,min:10,rx:false,batch:'PCM-2601',exp:plus(today(),540)},
{id:2,code:'OBT002',barcode:'899100100002',name:'Vitamin C 500 mg',category:'Suplemen',unit:'Strip',buy:5000,price:7500,stock:30,min:8,rx:false,batch:'VTC-2602',exp:plus(today(),420)},
{id:3,code:'OBT003',barcode:'899100100003',name:'Amoxicillin 500 mg',category:'Obat keras',unit:'Strip',buy:9000,price:13000,stock:18,min:5,rx:true,batch:'AMX-2601',exp:plus(today(),300)},
{id:4,code:'OBT004',barcode:'899100100004',name:'Antasida DOEN',category:'Obat bebas',unit:'Strip',buy:2500,price:4000,stock:7,min:10,rx:false,batch:'ANT-2603',exp:plus(today(),35)},
{id:5,code:'ALK001',barcode:'899100100005',name:'Masker medis',category:'Alat kesehatan',unit:'Box',buy:18000,price:25000,stock:22,min:5,rx:false,batch:'MSK-2601',exp:plus(today(),900)}
];
let db=JSON.parse(localStorage.getItem('apotekpos_db')||'null')||{products:seedProducts,sales:[],purchases:[],users:[{name:'Pemilik Apotek',role:'Pemilik',username:'owner'},{name:'Kasir 1',role:'Kasir',username:'kasir1'},{name:'Apoteker',role:'Apoteker',username:'apoteker'}],batches:[]};
let cart=[];
function save(){localStorage.setItem('apotekpos_db',JSON.stringify(db))}
function toast(s){let e=document.getElementById('toast');e.textContent=s;e.classList.remove('hidden');setTimeout(()=>e.classList.add('hidden'),2400)}
function nav(p){document.querySelectorAll('.page').forEach(x=>x.classList.add('hidden'));document.getElementById(p).classList.remove('hidden');document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===p));document.getElementById('topTitle').textContent=document.querySelector(`[data-page="${p}"]`).textContent.trim();({dashboard:renderDashboard,kasir:()=>{renderProducts();renderCart()},produk:renderInventory,stok:renderStock,pembelian:renderPurchases,laporan:renderReports,pengguna:renderUsers})[p]()}
document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>nav(b.dataset.page));
function renderDashboard(){let t=db.sales.filter(s=>s.date===today()),rev=t.reduce((a,s)=>a+s.total,0),profit=t.reduce((a,s)=>a+s.profit,0),low=db.products.filter(p=>p.stock<=p.min).length,near=db.products.filter(p=>p.exp&&p.exp<=plus(today(),90)).length;
document.getElementById('metrics').innerHTML=[['Penjualan hari ini',money(rev)],['Jumlah transaksi',t.length],['Estimasi laba kotor',money(profit)],['Produk perlu perhatian',low+near]].map(x=>`<div class="card"><div class="metriclabel">${x[0]}</div><div class="metric">${x[1]}</div></div>`).join('');
let days=Array.from({length:7},(_,i)=>plus(today(),i-6));let vals=days.map(d=>db.sales.filter(s=>s.date===d).reduce((a,s)=>a+s.total,0));let max=Math.max(1,...vals);document.getElementById('salesChart').innerHTML=days.map((d,i)=>`<div style="display:grid;grid-template-columns:65px 1fr 85px;gap:8px;align-items:center;margin:9px 0"><small>${d.slice(5)}</small><div style="background:#edf2f4;border-radius:8px;height:12px"><div style="background:#0e9f91;width:${vals[i]/max*100}%;height:12px;border-radius:8px"></div></div><small>${money(vals[i])}</small></div>`).join('');
document.getElementById('alerts').innerHTML=`<p>Stok menipis: <b>${low}</b> produk</p><p>Kedaluwarsa ≤ 90 hari: <b>${near}</b> produk</p><p>Total produk: <b>${db.products.length}</b></p>`;
document.getElementById('recent').innerHTML=salesTable(db.sales.slice(-6).reverse())}
function renderProducts(){let q=(document.getElementById('productSearch')?.value||'').toLowerCase();let a=db.products.filter(p=>(p.name+p.code+p.barcode).toLowerCase().includes(q));document.getElementById('productGrid').innerHTML=a.map(p=>`<button class="product" onclick="addCart(${p.id})"><small>${p.code} · ${p.category}</small><b>${p.name}</b><small>${money(p.price)} / ${p.unit} · Stok ${p.stock}</small><div style="margin-top:6px">${p.rx?'<span class="pill warn">Resep</span>':'<span class="pill">Non-resep</span>'}</div></button>`).join('')||'<div class="empty">Produk tidak ditemukan</div>'}
function addCart(id){let p=db.products.find(x=>x.id===id);if(!p||p.stock<1)return toast('Stok tidak tersedia');let c=cart.find(x=>x.id===id);if(c)c.qty++;else cart.push({id,qty:1});renderCart()}
function renderCart(){let el=document.getElementById('cart');if(!el)return;el.innerHTML=cart.map(c=>{let p=db.products.find(x=>x.id===c.id);return `<div class="cartline"><div><b>${p.name}</b><div class="muted small">${money(p.price)} × ${c.qty}</div></div><div class="actions"><button class="secondary" onclick="qty(${p.id},-1)">−</button><button class="secondary" onclick="qty(${p.id},1)">+</button><button class="danger" onclick="removeCart(${p.id})">×</button></div></div>`}).join('')||'<div class="empty">Keranjang masih kosong</div>';let sub=cart.reduce((a,c)=>a+db.products.find(p=>p.id===c.id).price*c.qty,0),disc=Math.max(0,Number(document.getElementById('discount')?.value)||0),tot=Math.max(0,sub-disc);document.getElementById('cartTotal').textContent=money(tot);let paid=Number(document.getElementById('paid')?.value)||0;document.getElementById('change').textContent=money(Math.max(0,paid-tot))}
function qty(id,n){let c=cart.find(x=>x.id===id);if(!c)return;c.qty+=n;if(c.qty<1)cart=cart.filter(x=>x.id!==id);renderCart()}
function removeCart(id){cart=cart.filter(x=>x.id!==id);renderCart()}
function checkout(){if(!cart.length)return toast('Keranjang kosong');for(let c of cart){let p=db.products.find(x=>x.id===c.id);if(c.qty>p.stock)return toast('Stok '+p.name+' tidak cukup');if(p.rx&&!confirm('Konfirmasi: resep '+p.name+' telah diverifikasi oleh petugas berwenang?'))return}
let sub=cart.reduce((a,c)=>a+db.products.find(p=>p.id===c.id).price*c.qty,0),disc=Math.max(0,Number(document.getElementById('discount').value)||0),total=Math.max(0,sub-disc),method=document.getElementById('payMethod').value,paid=Number(document.getElementById('paid').value)||0;if(method==='Tunai'&&paid<total)return toast('Uang diterima kurang dari total');
let lines=cart.map(c=>{let p=db.products.find(x=>x.id===c.id);p.stock-=c.qty;return {name:p.name,qty:c.qty,price:p.price,buy:p.buy,subtotal:p.price*c.qty,rx:p.rx}});let s={id:'TRX-'+Date.now(),date:today(),time:new Date().toLocaleTimeString('id-ID'),items:lines,total,discount:disc,method,paid:method==='Tunai'?paid:total,profit:lines.reduce((a,x)=>a+(x.price-x.buy)*x.qty,0)-disc};db.sales.push(s);save();cart=[];document.getElementById('discount').value=0;document.getElementById('paid').value='';renderCart();toast('Transaksi berhasil disimpan');if(confirm('Transaksi tersimpan. Cetak struk?'))printReceipt(s)}
function printReceipt(s){let w=open('','_blank','width=380,height=650');w.document.write(`<html><body style="font:13px monospace;width:280px;margin:20px auto"><center><h3>APOTEK</h3><p>Struk transaksi</p></center><hr>${s.id}<br>${s.date} ${s.time}<hr>${s.items.map(i=>`${i.name}<br>${i.qty} x ${money(i.price)} = ${money(i.subtotal)}`).join('<br>')}<hr>Total: ${money(s.total)}<br>Diskon: ${money(s.discount)}<br>Bayar: ${money(s.paid)}<br>Metode: ${s.method}<hr><center>Terima kasih</center><script>onload=()=>print()<\/script></body></html>`);w.document.close()}
function renderInventory(){let q=(document.getElementById('invSearch')?.value||'').toLowerCase(),a=db.products.filter(p=>(p.name+p.code+p.category).toLowerCase().includes(q));document.getElementById('productCount').textContent=a.length+' produk';document.getElementById('inventoryTable').innerHTML=`<table><thead><tr><th>Kode / Nama</th><th>Kategori</th><th>Harga beli</th><th>Harga jual</th><th>Stok</th><th>Min.</th><th>Resep</th><th>Aksi</th></tr></thead><tbody>${a.map(p=>`<tr><td><b>${p.code}</b><br>${p.name}<br><small class="muted">${p.barcode||''}</small></td><td>${p.category}</td><td>${money(p.buy)}</td><td>${money(p.price)}</td><td>${p.stock}</td><td>${p.min}</td><td>${p.rx?'Ya':'Tidak'}</td><td><button class="secondary" onclick="openProduct(${p.id})">Edit</button></td></tr>`).join('')}</tbody></table>`}
function renderStock(){document.getElementById('stockTable').innerHTML=`<table><thead><tr><th>Produk</th><th>Batch</th><th>Kedaluwarsa</th><th>Stok</th><th>Status</th></tr></thead><tbody>${db.products.map(p=>{let days=p.exp?Math.ceil((new Date(p.exp)-new Date(today()))/86400000):9999,cl=days<0?'bad':days<=90?'warn':'';return `<tr><td>${p.name}</td><td>${p.batch||'-'}</td><td>${p.exp||'-'}</td><td>${p.stock}</td><td><span class="pill ${cl}">${days<0?'Kedaluwarsa':days<=90?'Segera kedaluwarsa':p.stock<=p.min?'Stok menipis':'Normal'}</span></td></tr>`}).join('')}</tbody></table>`}
function renderPurchases(){document.getElementById('purchaseTable').innerHTML=db.purchases.length?`<table><tr><th>Tanggal</th><th>Pemasok</th><th>Produk</th><th>Jumlah</th><th>Total</th></tr>${db.purchases.slice().reverse().map(x=>`<tr><td>${x.date}</td><td>${x.supplier}</td><td>${x.product}</td><td>${x.qty}</td><td>${money(x.total)}</td></tr>`).join('')}</table>`:'<div class="empty">Belum ada pembelian tercatat</div>'}
function salesTable(a){return a.length?`<table><tr><th>ID</th><th>Tanggal</th><th>Item</th><th>Pembayaran</th><th>Total</th></tr>${a.map(s=>`<tr><td>${s.id}</td><td>${s.date}</td><td>${s.items.length}</td><td>${s.method}</td><td><b>${money(s.total)}</b></td></tr>`).join('')}</table>`:'<div class="empty">Belum ada transaksi</div>'}
function renderReports(){let f=document.getElementById('fromDate')?.value||plus(today(),-30),t=document.getElementById('toDate')?.value||today();let a=db.sales.filter(s=>s.date>=f&&s.date<=t),sum=a.reduce((x,s)=>x+s.total,0),pr=a.reduce((x,s)=>x+s.profit,0);document.getElementById('reportSummary').innerHTML=`<div class="grid" style="margin:15px 0"><div class="card">Transaksi<div class="metric">${a.length}</div></div><div class="card">Omzet<div class="metric">${money(sum)}</div></div><div class="card">Estimasi laba kotor<div class="metric">${money(pr)}</div></div><div class="card">Rata-rata transaksi<div class="metric">${money(a.length?sum/a.length:0)}</div></div></div>`;document.getElementById('reportTable').innerHTML=salesTable(a.slice().reverse())}
function renderUsers(){document.getElementById('userTable').innerHTML=`<table><tr><th>Nama</th><th>Username</th><th>Peran</th><th>Akses contoh</th></tr>${db.users.map(u=>`<tr><td>${u.name}</td><td>${u.username}</td><td>${u.role}</td><td>${u.role==='Kasir'?'Transaksi kasir':u.role==='Apoteker'?'Verifikasi pelayanan resep':'Semua modul (sesuai kewenangan)'}</td></tr>`).join('')}</table>`}
function modal(title,body){document.getElementById('modalRoot').innerHTML=`<div class="modalback" onclick="if(event.target===this)this.remove()"><div class="modal"><div class="row" style="justify-content:space-between"><h2>${title}</h2><button class="secondary" onclick="document.getElementById('modalRoot').innerHTML=''">Tutup</button></div>${body}</div></div>`}
function openProduct(id){let p=db.products.find(x=>x.id===id)||{id:0,code:'',barcode:'',name:'',category:'Obat bebas',unit:'Strip',buy:0,price:0,stock:0,min:0,rx:false,batch:'',exp:''};modal(id?'Edit produk':'Tambah produk',`<form onsubmit="saveProduct(event,${id||0})"><div class="field"><label>Kode produk</label><input name="code" required value="${p.code}"></div><div class="field"><label>Barcode</label><input name="barcode" value="${p.barcode}"></div><div class="field"><label>Nama produk</label><input name="name" required value="${p.name}"></div><div class="field"><label>Kategori</label><select name="category">${['Obat bebas','Obat bebas terbatas','Obat keras','Suplemen','Alat kesehatan','Lainnya'].map(x=>`<option ${p.category===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="row"><div class="field"><label>Satuan</label><input name="unit" value="${p.unit}" required></div><div class="field"><label>Harga beli</label><input name="buy" type="number" min="0" value="${p.buy}" required></div><div class="field"><label>Harga jual</label><input name="price" type="number" min="0" value="${p.price}" required></div></div><div class="row"><div class="field"><label>Stok</label><input name="stock" type="number" min="0" value="${p.stock}"></div><div class="field"><label>Stok minimum</label><input name="min" type="number" min="0" value="${p.min}"></div></div><div class="field"><label>Nomor batch</label><input name="batch" value="${p.batch}"></div><div class="field"><label>Kedaluwarsa</label><input name="exp" type="date" value="${p.exp}"></div><label><input type="checkbox" name="rx" ${p.rx?'checked':''}> Memerlukan resep</label><p><button type="submit">Simpan produk</button></p></form>`)}
function saveProduct(e,id){e.preventDefault();let f=new FormData(e.target),p={id:id||Date.now(),code:f.get('code'),barcode:f.get('barcode'),name:f.get('name'),category:f.get('category'),unit:f.get('unit'),buy:+f.get('buy'),price:+f.get('price'),stock:+f.get('stock'),min:+f.get('min'),batch:f.get('batch'),exp:f.get('exp'),rx:f.has('rx')};let i=db.products.findIndex(x=>x.id===id);if(i>=0)db.products[i]=p;else db.products.push(p);save();document.getElementById('modalRoot').innerHTML='';renderInventory();renderDashboard();toast('Produk disimpan')}
function openBatch(){modal('Catat stok masuk / batch',`<form onsubmit="saveBatch(event)"><div class="field"><label>Produk</label><select name="id" required>${db.products.map(p=>`<option value="${p.id}">${p.name}</option>`).join('')}</select></div><div class="field"><label>Jumlah masuk</label><input name="qty" type="number" min="1" required></div><div class="field"><label>Nomor batch</label><input name="batch" required></div><div class="field"><label>Tanggal kedaluwarsa</label><input name="exp" type="date" required></div><button>Simpan stok masuk</button></form>`)}
function saveBatch(e){e.preventDefault();let f=new FormData(e.target),p=db.products.find(x=>x.id===+f.get('id'));p.stock+=+f.get('qty');p.batch=f.get('batch');p.exp=f.get('exp');db.batches.push({product:p.name,qty:+f.get('qty'),batch:p.batch,exp:p.exp,date:today()});save();document.getElementById('modalRoot').innerHTML='';renderStock();toast('Stok masuk dicatat')}
function openPurchase(){modal('Catat pembelian',`<form onsubmit="savePurchase(event)"><div class="field"><label>Pemasok</label><input name="supplier" required></div><div class="field"><label>Produk</label><select name="id">${db.products.map(p=>`<option value="${p.id}">${p.name}</option>`).join('')}</select></div><div class="field"><label>Jumlah</label><input name="qty" type="number" min="1" required></div><div class="field"><label>Harga beli per unit</label><input name="price" type="number" min="0" required></div><button>Simpan pembelian</button></form>`)}
function savePurchase(e){e.preventDefault();let f=new FormData(e.target),p=db.products.find(x=>x.id===+f.get('id')),q=+f.get('qty'),pr=+f.get('price');p.stock+=q;p.buy=pr;db.purchases.push({supplier:f.get('supplier'),product:p.name,qty:q,total:q*pr,date:today()});save();document.getElementById('modalRoot').innerHTML='';renderPurchases();toast('Pembelian dicatat dan stok bertambah')}
function openUser(){modal('Tambah pengguna',`<form onsubmit="saveUser(event)"><div class="field"><label>Nama</label><input name="name" required></div><div class="field"><label>Username</label><input name="username" required></div><div class="field"><label>Peran</label><select name="role"><option>Kasir</option><option>Apoteker</option><option>Pemilik</option></select></div><button>Simpan pengguna</button></form>`)}
function saveUser(e){e.preventDefault();let f=new FormData(e.target);db.users.push({name:f.get('name'),username:f.get('username'),role:f.get('role')});save();document.getElementById('modalRoot').innerHTML='';renderUsers();toast('Pengguna ditambahkan')}
function resetDemo(){if(confirm('Hapus data lokal dan kembalikan data contoh?')){localStorage.removeItem('apotekpos_db');location.reload()}}
document.getElementById('fromDate').value=plus(today(),-30);document.getElementById('toDate').value=today();document.getElementById('paid').addEventListener('input',renderCart);save();renderDashboard();
</script></body></html>
